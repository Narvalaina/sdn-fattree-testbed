# Normalize source/documentation text to LF across platforms.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
tfgctl text eol=lf

# Preserve selected historical CSV evidence byte-for-byte.
data/**/*.csv -text

# Binary artefacts.
figures/**/*.png binary
